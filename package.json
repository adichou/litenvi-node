{
  "name": "litenvi-node",
  "version": "0.1.0",
  "description": "可切换的 Node 与浏览器环境门面：文件系统、进程、Git、HTTP、时钟和 Playwright，测试通过 lite-* 组件装配内存环境。",
  "type": "module",
  "exports": {
    "./*": "./scripts/*"
  },
  "files": [
    "scripts/*.mjs",
    "scripts/*.cjs"
  ],
  "scripts": {
    "test": "node --test scripts/tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage scripts/tests/*.test.mjs",
    "lint": "eslint . --max-warnings 0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adichou/litenvi-node.git"
  },
  "dependencies": {
    "@sinonjs/fake-timers": "15.4.0",
    "playwright": "^1.64.1",
    "shell-quote": "1.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "atb-eslint-plugin": "file:../atb-eslint-plugin",
    "eslint": "9.39.4",
    "eslint-plugin-package-json": "0.91.2"
  }
}
