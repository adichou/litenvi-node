{
  "name": "litenvi-node",
  "version": "0.1.0",
  "description": "可切换的 Node 与浏览器环境门面：文件系统、进程、Git、HTTP、时钟和 Playwright，测试通过 lite-* 组件装配内存环境。",
  "type": "module",
  "exports": {
    "./*": "./*"
  },
  "files": [
    "*.mjs",
    "*.cjs"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adichou/litenvi-node.git"
  },
  "dependencies": {
    "@sinonjs/fake-timers": "15.4.0",
    "shell-quote": "1.12.0",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
